# Environment
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# App
PORT=3030
PUBLIC_WEB_URL=http://localhost:5173
CUSTOM_DOMAIN_CNAME_TARGET=linksbuds.com
BETTER_AUTH_URL=http://localhost:3030
BETTER_AUTH_SECRET=dev-only-secret-change-me-32chars
# Internal admin API (/admin/*, header x-admin-key). Unset = disabled.
ADMIN_API_KEY=

# Database
DATABASE_URL=
TYPEORM_MIGRATIONS_RUN=false

# Redis
REDIS_URL=redis://localhost:6379
LINK_PAGE_ONLINE_TTL_SECONDS=90
LINK_PAGE_PUBLIC_CACHE_TTL_SECONDS=300

# Google OAuth
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Billing: gateway for NEW checkouts (unset = disabled; "fake" = dev simulator, never in production)
BILLING_PROVIDER=
# Former gateways (comma list) kept until their subscriptions end: webhooks, cancel, renewals, receipts
BILLING_LEGACY_PROVIDERS=
BILLING_FAKE_SECRET=
# Asaas (BILLING_PROVIDER=asaas). Sandbox: https://api-sandbox.asaas.com/v3 · Prod: https://api.asaas.com/v3
# Key starts with "$": keep it in single quotes. Webhook token: 32+ chars (openssl rand -hex 32).
ASAAS_API_URL=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Email (Resend). Unset in dev = emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM=LinkBuds <no-reply@linksbuds.com>
