{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "incremental": false,
    "types": ["node"]
  },
  "include": [
    "src/main.ts",
    "src/app/**/*.ts",
    "src/cli/**/*.ts",
    "src/infra/**/*.ts",
    "src/middlewares/**/*.ts",
    "src/modules/**/*.ts",
    "src/shared/**/*.ts"
  ],
  "exclude": ["node_modules", "test", "dist", "coverage", "**/*.spec.ts"]
}
